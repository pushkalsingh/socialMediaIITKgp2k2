generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminStatus {
  PENDING
  APPROVED
  REJECTED
}

model Admin {
  id    String @id @default(cuid())
  email String @unique
  name  String
  // Unused for now — no password login while this is a small, trusted group.
  // Left in place so password login can be turned back on later without a migration.
  passwordHash String?
  // Institute ID, e.g. 02ME3031 (year + department + roll number). This is the
  // login credential (alongside email) while there's no password.
  identificationNumber String?     @unique
  isSuperAdmin         Boolean     @default(false)
  status               AdminStatus @default(APPROVED)
  createdAt            DateTime    @default(now())

  categories Category[] @relation("CategoryAddedBy")
  people     Person[]   @relation("AddedBy")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String
  icon        String? // single emoji shown next to the category name
  createdAt   DateTime @default(now())

  addedById String?
  addedBy   Admin?  @relation("CategoryAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  people Person[]
}

model Person {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  bio        String
  avatarUrl  String?
  verified   Boolean  @default(false) // has an admin double-checked the links are live?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  addedById String?
  addedBy   Admin?  @relation("AddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  youtubeUrl   String?
  instagramUrl String?
  facebookUrl  String?
  xUrl         String?
  tiktokUrl    String?
  websiteUrl   String?

  @@index([categoryId])
}
